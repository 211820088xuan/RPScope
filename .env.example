# RPScope environment - copy to .env and fill in
# GLM (OpenAI-compatible) via DashScope - P2/P6/P9 起用
GLM_API_KEY=
GLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_MODEL=glm-5.2

# LLM 总开关 - false 时全部走降级路径（测试/演示用）
RPSCOPE_LLM_ENABLED=true

# P1 起 - Docker 服务
POSTGRES_USER=rpscope
POSTGRES_PASSWORD=rpscope
POSTGRES_DB=rpscope
NEO4J_AUTH=neo4j/rpscope123

# akshare 探针参数
RPSCOPE_CACHE_DIR=.cache
RPSCOPE_RATE_LIMIT_RPS=2.0
RPSCOPE_PROBE_DB=probe.db
